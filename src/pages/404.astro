---
import Layout from '../layouts/Layout.astro';
import { BRAND } from '../lib/brand';
---

<Layout title={`Page not found · ${BRAND.name}`}>
  <div class="mx-auto max-w-xl px-4 py-24 text-center">
    <p class="text-xs tracking-[0.2em] text-signal uppercase">404</p>
    <h1 class="mt-3 text-3xl font-bold">This look does not exist.</h1>
    <p class="mt-3 text-sm text-mist">The piece you wanted may have moved, or the link is incomplete.</p>
    <a href="/" class="mt-8 inline-flex rounded-xl bg-signal px-5 py-3 text-sm font-semibold">Return home</a>
  </div>
</Layout>
