---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero';
import HowItWorks from '../components/home/HowItWorks';
import TryOnSpotlight from '../components/home/TryOnSpotlight';
import ShopByIntent from '../components/home/ShopByIntent';
import CollectionSection from '../components/CollectionSection';
import AtelierLooks from '../components/home/AtelierLooks';
import FitConfidence from '../components/home/FitConfidence';
import { BRAND } from '../lib/brand';

const category = Astro.url.searchParams.get('category') ?? 'all';
---

<Layout title={BRAND.name}>
  <script is:inline slot="head">
    (function () {
      try {
        if (window.__ifSplashDone || window.__ifAstroClientNav) {
          document.documentElement.classList.remove('if-splash');
          return;
        }
        var path = location.pathname;
        if (path !== '/' && path !== '') return;
        var nav = performance.getEntriesByType('navigation')[0];
        if (nav && nav.type === 'back_forward') return;
        document.documentElement.classList.add('if-splash');
      } catch (e) {}
    })();
  </script>
  <Hero client:load />
  <CollectionSection client:load initialCategory={category} />
  <HowItWorks client:visible />
  <TryOnSpotlight client:visible />
  <ShopByIntent client:visible />
  <AtelierLooks client:visible />
  <FitConfidence client:visible />
</Layout>
