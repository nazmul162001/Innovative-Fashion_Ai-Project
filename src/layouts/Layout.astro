---
import { BRAND } from '../lib/brand';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Drawers from '../components/Drawers';
import Toaster from '../components/Toaster';
import InstallPrompt from '../components/InstallPrompt';
import FloatingCart from '../components/FloatingCart';
import SwipeBack from '../components/SwipeBack';

interface Props {
  title: string;
  description?: string;
}

const { title, description = BRAND.description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0F1218" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={BRAND.short} />
    <meta name="application-name" content={BRAND.short} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <slot name="head" />
    <ClientRouter />
  </head>
  <body class="hero-bg min-h-screen max-w-full overflow-x-clip font-sans text-snow antialiased">
    <script is:inline>
      document.addEventListener(
        'click',
        function (event) {
          if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          var target = event.target;
          var anchor = target && target.closest ? target.closest('a') : null;
          if (!anchor) return;
          var href = anchor.getAttribute('href');
          if (!href) return;
          var url;
          try {
            url = new URL(href, location.href);
          } catch (err) {
            return;
          }
          if (url.origin !== location.origin || url.pathname !== '/' || location.pathname !== '/') return;
          event.preventDefault();
          event.stopPropagation();
          var category = url.searchParams.get('category') || 'all';
          var next = url.pathname + url.search + url.hash;
          var current = location.pathname + location.search + location.hash;
          if (next !== current) history.pushState({ category: category }, '', next);
          window.dispatchEvent(new CustomEvent('if:category', { detail: category }));
          if (url.hash) {
            var el = document.getElementById(url.hash.slice(1));
            if (el) el.scrollIntoView({ behavior: 'smooth' });
          } else if (!url.search) {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        },
        true,
      );
    </script>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[90] focus:rounded-lg focus:bg-signal focus:px-3 focus:py-2"
    >
      Skip to content
    </a>
    <div id="swipe-back-root" class="relative z-[35] min-h-screen max-w-full overflow-x-clip bg-[#0F1218]">
      <Header />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
    <Drawers client:load />
    <Toaster client:load />
    <FloatingCart client:load />
    <SwipeBack client:load />
    <InstallPrompt client:only="react" />
  </body>
</html>
