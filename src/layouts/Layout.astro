---
import { BRAND } from '../lib/brand';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Drawers from '../components/Drawers';
import Toaster from '../components/Toaster';
import InstallPrompt from '../components/InstallPrompt';
import FloatingCart from '../components/FloatingCart';
import SplashLoader from '../components/SplashLoader';

interface Props {
  title: string;
  description?: string;
}

const { title, description = BRAND.description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0F1218" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={BRAND.short} />
    <meta name="application-name" content={BRAND.short} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <!-- Critical third-party origins -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="dns-prefetch" href="https://images.unsplash.com" />
    <!-- Subset weights used by the UI — fewer bytes than 300–800. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <slot name="head" />
    <ClientRouter />
  </head>
  <body class="hero-bg min-h-screen max-w-full overflow-x-clip font-sans text-snow antialiased">
    <script is:inline>
      (function () {
        // Inline layout scripts re-run on every ClientRouter swap — init once.
        if (window.__ifNavInit) return;
        window.__ifNavInit = true;

        var SCROLL_KEY = 'if-scroll-map';

        try {
          if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        } catch (e) {}

        window.__ifPageLoads = 0;
        window.__ifIsPopNav = false;

        document.addEventListener('astro:page-load', function () {
          window.__ifPageLoads = (window.__ifPageLoads || 0) + 1;
          if (window.__ifPageLoads > 1) window.__ifAstroClientNav = true;
        });

        function pathKey(url) {
          var u = url || location;
          return (u.pathname || '') + (u.search || '');
        }

        function readMap() {
          try {
            return JSON.parse(sessionStorage.getItem(SCROLL_KEY) || '{}');
          } catch (e) {
            return {};
          }
        }

        function writeMap(map) {
          try {
            sessionStorage.setItem(SCROLL_KEY, JSON.stringify(map));
          } catch (e) {}
        }

        function saveScrollForCurrent() {
          var map = readMap();
          map[pathKey()] = window.scrollY || window.pageYOffset || 0;
          writeMap(map);
        }

        function scrollTop() {
          window.scrollTo({ left: 0, top: 0, behavior: 'instant' });
          document.documentElement.scrollTop = 0;
          document.body.scrollTop = 0;
        }

        function applyScrollY(y) {
          window.scrollTo({ left: 0, top: y, behavior: 'instant' });
          document.documentElement.scrollTop = y;
          document.body.scrollTop = y;
        }

        function restoreScroll() {
          var map = readMap();
          var y = map[pathKey()];
          // Prefer Astro's history.state scroll when present.
          if (history.state && typeof history.state.scrollY === 'number' && history.state.scrollY > 0) {
            y = history.state.scrollY;
          }
          if (typeof y !== 'number') {
            scrollTop();
            return;
          }
          applyScrollY(y);
          // Re-apply after layout/images/GSAP so the position sticks.
          requestAnimationFrame(function () {
            applyScrollY(y);
            requestAnimationFrame(function () {
              applyScrollY(y);
            });
          });
          window.setTimeout(function () {
            applyScrollY(y);
          }, 120);
        }

        window.addEventListener('popstate', function () {
          window.__ifIsPopNav = true;
        });

        // Capture position right before leaving a page (forward link clicks).
        document.addEventListener('astro:before-preparation', function () {
          if (!window.__ifIsPopNav) saveScrollForCurrent();
        });

        function onArrive() {
          if (window.__ifIsPopNav) {
            restoreScroll();
            // Keep the flag long enough for islands (e.g. ProductDetail) to skip top scroll.
            window.setTimeout(function () {
              window.__ifIsPopNav = false;
            }, 300);
            return;
          }
          scrollTop();
        }

        document.addEventListener('astro:after-swap', onArrive);
        document.addEventListener('astro:page-load', function () {
          if (window.__ifIsPopNav) {
            restoreScroll();
            return;
          }
          // Initial full page load only (no prior swap): start at top.
          if ((window.__ifPageLoads || 0) <= 1) scrollTop();
        });

        document.addEventListener(
          'click',
          function (event) {
            if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
            var target = event.target;
            var anchor = target && target.closest ? target.closest('a') : null;
            if (!anchor) return;
            var href = anchor.getAttribute('href');
            if (!href) return;
            var url;
            try {
              url = new URL(href, location.href);
            } catch (err) {
              return;
            }
            if (url.origin !== location.origin) return;

            if (url.pathname !== '/' || location.pathname !== '/') return;
            event.preventDefault();
            event.stopPropagation();
            var category = url.searchParams.get('category') || 'all';
            var next = url.pathname + url.search + url.hash;
            var current = location.pathname + location.search + location.hash;
            if (next !== current) {
              // Preserve Astro ClientRouter scroll state on history entries.
              var prev = history.state && typeof history.state === 'object' ? history.state : {};
              history.pushState(
                Object.assign({}, prev, {
                  category: category,
                  scrollX: window.scrollX || 0,
                  scrollY: window.scrollY || 0,
                }),
                '',
                next,
              );
            }
            window.dispatchEvent(new CustomEvent('if:category', { detail: category }));
            if (url.hash) {
              var el = document.getElementById(url.hash.slice(1));
              if (el) el.scrollIntoView({ behavior: 'smooth' });
            } else if (!url.search) {
              scrollTop();
            }
          },
          true,
        );
      })();
    </script>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[90] focus:rounded-lg focus:bg-signal focus:px-3 focus:py-2"
    >
      Skip to content
    </a>
    <div class="min-h-screen max-w-full overflow-x-clip bg-[#0F1218]">
      <Header />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
    <!-- Idle: keep first paint free; cart/toast still ready within ~1 tick after load. -->
    <Drawers client:idle />
    <Toaster client:idle />
    <FloatingCart client:idle />
    <SplashLoader client:only="react" />
    <InstallPrompt client:only="react" />
  </body>
</html>
